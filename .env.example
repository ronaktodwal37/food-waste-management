# -----------------------------------------------------------------------------
# ZERO-WASTE FOOD SHARING & REDISTRIBUTION PLATFORM
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3000
BACKEND_PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Firebase Client Configuration (Frontend - React Vite)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK Configuration (Backend - Express Node.js)
# Required in Phase 2 for token verification & Firestore server operations
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# Map & Routing Configuration (Phase 5)
# OpenStreetMap Tile URL template (Configurable provider)
VITE_OSM_TILE_LAYER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
