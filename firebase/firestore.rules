rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isApprovedNGO() {
      return hasRole('NGO') && getUserData().isApproved == true;
    }

    // 1. Users collection: User profile documents
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // Only created during signup without arbitrary role elevation
      allow create: if isOwner(userId) && request.resource.data.role in ['FOOD_DONOR', 'NGO', 'VOLUNTEER', 'COMMUNITY_USER'];
      // Users cannot elevate their own role or approve themselves
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved', 'status']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Organizations collection (Donors and NGOs)
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (resource.data.ownerUid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'status']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Volunteer Profiles
    match /volunteerProfiles/{volunteerId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(volunteerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Food Listings
    match /foodListings/{listingId} {
      // Publicly readable for discovery by authenticated users
      allow read: if isAuthenticated();
      // Only authenticated FOOD_DONOR can create listings with their own donorUid
      allow create: if hasRole('FOOD_DONOR') && request.resource.data.donorUid == request.auth.uid;
      // Donor can update/cancel their own unallocated listing; critical allocations done via Admin SDK
      allow update: if (resource.data.donorUid == request.auth.uid && resource.data.status in ['AVAILABLE', 'CANCELLED']) || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Food Allocations (Atomic multi-NGO claims - managed via Server API)
    match /foodAllocations/{allocationId} {
      allow read: if isAuthenticated() && (
        resource.data.ngoUid == request.auth.uid ||
        resource.data.donorUid == request.auth.uid ||
        isAdmin()
      );
      // All creation/updates are performed atomically via Express Backend (Firebase Admin SDK)
      allow write: if isAdmin();
    }

    // 6. Volunteer Tasks & 7. Deliveries
    match /volunteerTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated() && (
        resource.data.volunteerUid == request.auth.uid ||
        resource.data.ngoUid == request.auth.uid ||
        resource.data.donorUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 8. Delivery Verifications (Hashed OTPs - strictly server-only)
    match /deliveryVerifications/{verificationId} {
      allow read, write: if false; // Only accessible via Firebase Admin SDK
    }

    // 9. Volunteer Credits & 10. Credit Rules
    match /volunteerCredits/{creditId} {
      allow read: if isAuthenticated() && (resource.data.volunteerUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /creditRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Badges & 12. Volunteer Badges
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /volunteerBadges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 13. Community Requests & Listings
    match /communityRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('COMMUNITY_USER') && request.resource.data.requesterUid == request.auth.uid;
      allow update: if (resource.data.requesterUid == request.auth.uid) || isAdmin();
      allow delete: if (resource.data.requesterUid == request.auth.uid) || isAdmin();
    }

    // 14. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if isAdmin();
    }

    // 15. Reports (Unsafe food or misleading listings)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 16. Impact Records
    match /impactRecords/{recordId} {
      allow read: if true; // Public verified aggregate / impact proof
      allow write: if isAdmin();
    }

    // 17. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only via Firebase Admin SDK
    }
  }
}
